# Copiá este archivo a .env solo para pruebas locales. NUNCA subas el .env a GitHub.
# En Vercel se cargan en Settings > Environment Variables.

# Lo inventás vos: cualquier texto largo y secreto. Se usa al configurar el webhook en Meta.
VERIFY_TOKEN=poneAcaUnTextoSecretoLargo123

# Token de acceso de WhatsApp (ideal: token permanente de un System User)
WHATSAPP_TOKEN=

# ID del número de teléfono (WhatsApp > API Setup en developers.facebook.com)
PHONE_NUMBER_ID=

# API key gratis de https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional
# GEMINI_MODEL=gemini-2.5-flash
